#!/bin/sh
#
# Apply PL device-tree overlay via configfs.
# The FPGA is already programmed by BOOT.bin (FSBL stage).
# This overlay only adds device nodes for PL peripherals.
#

OVERLAY_DIR=/sys/kernel/config/device-tree/overlays/pl
OVERLAY_FILE=/mnt/pl-ebaz4205.dtbo
BOOT_PART=/dev/mmcblk0p1

case "$1" in
  start)
	echo -n "Applying PL device-tree overlay: "

	# Mount boot partition if not already mounted
	mountpoint -q /mnt || mount $BOOT_PART /mnt 2>/dev/null || true

	if [ ! -f "$OVERLAY_FILE" ]; then
		echo "FAIL (overlay file not found at $OVERLAY_FILE)"
		exit 1
	fi

	if [ ! -d /sys/kernel/config/device-tree/overlays ]; then
		echo "FAIL (configfs not mounted, check /etc/fstab)"
		exit 1
	fi

	mkdir -p "$OVERLAY_DIR" 2>/dev/null
	if [ ! -d "$OVERLAY_DIR" ]; then
		echo "FAIL (cannot create overlay directory)"
		exit 1
	fi

	cat "$OVERLAY_FILE" > "$OVERLAY_DIR/dtbo" 2>/dev/null
	if [ $? -eq 0 ]; then
		echo "OK"
	else
		echo "FAIL (kernel rejected overlay)"
		rmdir "$OVERLAY_DIR" 2>/dev/null
		exit 1
	fi
	;;
  stop)
	echo -n "Removing PL device-tree overlay: "
	if rmdir "$OVERLAY_DIR" 2>/dev/null; then
		echo "OK"
	else
		echo "FAIL"
	fi
	;;
  restart|reload)
	$0 stop
	sleep 1
	$0 start
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac

exit 0